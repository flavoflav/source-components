    "b9e24120-5046-5115-9363-9771f9a01f81": {
      "type": "js.accordion-item",
      "props": {
        "question": "Is my money protected if Northwind fails?",
        "answer": "<p>Customer funds are safeguarded in segregated accounts at tier-1 banks and are not part of our balance sheet. Safeguarded funds are not covered by FSCS deposit protection - safeguarding is a different, and in insolvency generally faster, mechanism.</p>",
        "defaultOpen": true
      }
    },
    "186068ec-ed17-5464-a994-137d04b858dd": {
      "type": "js.accordion-item",
      "props": {
        "question": "Who holds the regulatory obligation for KYC?",
        "answer": "<p>On our licence, we do. Where you operate as an agent or distributor, obligations are set out in the schedule to your agreement.</p>"
      }
    },
    "41ce4394-f18c-5975-bf24-4603cb522e72": {
      "type": "js.accordion-item",
      "props": {
        "question": "Can we operate in a jurisdiction where you are not licensed?",
        "answer": "<p>Sometimes, through a partner institution. It changes settlement times and pricing, so raise it during onboarding rather than after.</p>"
      }
    },
    "1ad75306-e469-5d48-9951-78985e02cda7": {
      "type": "js.accordion-item",
      "props": {
        "question": "What are the transaction limits?",
        "answer": "<p>Limits are set per account at onboarding based on expected volume and risk profile, and reviewed quarterly.</p>"
      }
    },
    "3002d95d-bb30-5db0-a80c-fb8de1a373dd": {
      "type": "js.accordion-item",
      "props": {
        "question": "How do you handle chargebacks and recalls?",
        "answer": "<p>Recalls are surfaced as webhook events with a response window. Card chargebacks follow scheme timelines with evidence submitted through the API or dashboard.</p>"
      }
    },
