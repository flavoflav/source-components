      "type": "js.accordion-item",
      "props": {
        "question": "How much of my donation reaches the programmes?",
        "answer": "<p>87 pence in every pound. The remaining 13 covers fundraising and governance - the costs that make the 87 possible.</p>",
        "defaultOpen": true
      }
    },
    "e856c8e2-7c76-5281-af13-8e0d14f55387": {
      "type": "js.accordion-item",
      "props": {
        "question": "Can I choose which country my gift supports?",
        "answer": "<p>Restricted gifts of £10,000 or more can be directed to a country programme. Below that we pool funds, because it lets us respond where need is greatest rather than where fundraising happened to land.</p>"
      }
    },
    "88993f14-b225-5e17-839f-acdc6b6546f3": {
      "type": "js.accordion-item",
      "props": {
        "question": "How do you know the systems still work?",
        "answer": "<p>Every pump carries a sensor reporting daily flow. That data is published, including the failures.</p>"
      }
    },
    "ffce8c80-0aa3-5885-9ca3-0567374423ab": {
      "type": "js.accordion-item",
      "props": {
        "question": "Are you a registered charity?",
        "answer": "<p>Yes - registered charity number 1123456 in England and Wales, with audited accounts filed annually.</p>"
      }
